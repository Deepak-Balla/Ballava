# Copy this file to ".env" and fill in your values. Never share your .env file.

# Optional: switches on AI Chef (invent dishes + fridge photo scan).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model to use.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: port the app runs on (default 3000).
PORT=3000

# Optional: max AI requests per visitor per minute (protects your bill).
AI_RATE_LIMIT=10

# Where the database file lives (default data/ballava.db). Back this file up.
# DB_PATH=data/ballava.db

# Phone sign-in. Pick ONE of these:
# 1. For trying it out on your own computer: shows the code on screen, sends no SMS.
#    Never use this on a live website.
# OTP_DEV_MODE=1
# 2. For real SMS, from a Twilio account (https://www.twilio.com):
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
