# Copy this file to ".env" and fill in what you need. Every setting is optional on your own computer.
# Never share your .env file, and never put it on GitHub.

# ---- AI Chef (optional): invent dishes and scan fridge photos.
# Pick which AI to use: gemini (Google, has a free tier) or claude (Anthropic, paid). Restart after changing.
AI_PROVIDER=gemini

# Google Gemini. Get a free key at https://aistudio.google.com/apikey
# Note: on Google's free tier, Google may use what is sent (kitchen items, family diet needs) to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude. Get a key at https://platform.claude.com (needs billing).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max AI requests per family (or visitor) per minute. Protects your bill and free limits.
AI_RATE_LIMIT=10

# ---- How long Ballava keeps what people do, in days (180 = 6 months). Diary meals, saved dishes, AI recipes and chats
# older than this are deleted, and so are family accounts nobody has used for this long. 0 keeps everything forever.
DATA_RETENTION_DAYS=180

# ---- Phone sign-in. Pick ONE:
# 1. Trying it on your own computer: the code is shown on screen, no SMS is sent. Ignored when DJANGO_DEBUG=0.
# OTP_DEV_MODE=1
# 2. Real SMS from a Twilio account (https://www.twilio.com). Sending SMS to India also needs DLT registration.
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# ---- Opening Ballava on your phone (README: "Use Ballava on your phone"). Add this computer's Wi-Fi address
# (ipconfig -> IPv4 Address), and .trycloudflare.com for the free https link:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.5,.trycloudflare.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# The address to put in links you share on WhatsApp (family vote), if you usually open Ballava on localhost or Wi-Fi
# but your family should use another address. Leave empty to use the address you have open.
# PUBLIC_URL=https://ballava.example.com

# ---- Sign-in with Supabase (optional): email codes, password reset and Google. Steps: DEPLOY.md
# Empty = Ballava's own email-and-password accounts. The first two are public; the secret key must never leave the server.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# ---- Online database (optional). Empty = one SQLite file in the data folder. Steps: DEPLOY.md
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Your own domain, without https:// (also allows its www address, and is used in links you share).
# SITE_DOMAIN=ballava.com

# ---- Only needed when you put Ballava on the internet (Docker sets the first one for you):
# DJANGO_DEBUG=0
# A long random secret. Make one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# If you leave it empty, one is created once and kept in the data folder.
# DJANGO_SECRET_KEY=
# Your website's address(es), comma separated.
# DJANGO_ALLOWED_HOSTS=ballava.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ballava.example.com
# Set to 1 when the site is served over https.
# DJANGO_SECURE=1
# Where the database and secret key live (default: the data folder). Back this folder up.
# DATA_DIR=data
