{
  "name": "ballava",
  "version": "1.0.0",
  "description": "Ballava: cook with what you have. Pantry-aware recipe suggestions, cook mode with timers and whistle counter, kitchen rescue, family diets and optional AI chef.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "start": "node server/server.mjs",
    "build": "node build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/engine.test.mjs tests/api.test.mjs",
    "test:e2e": "node --test tests/e2e.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "playwright": "^1.50.0"
  }
}
